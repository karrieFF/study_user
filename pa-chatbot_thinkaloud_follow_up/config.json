{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.1/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "AI Health Coach Think-Aloud Study",
    "version": "1.0.0",
    "authors": [
      "Lingyi Fu"
    ],
    "date": "2025-11-12",
    "description": "A think-aloud usability study evaluating a chatbot app for promoting physical activity",
    "organizations": [
      "University of Utah"
    ]
  },
  "uiConfig": {
    "urlParticipantIdParam": "REDCAP_ID",
    "contactEmail": "Lingyi.Fu@utah.edu",
    "helpTextPath": "pa-chatbot_thinkaloud_follow_up/assets/help.md",
    "stylesheetPath": "pa-chatbot_thinkaloud_follow_up/assets/styles.css",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "logoTo": "/",
    "withProgressBar": false,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "enumerateQuestions": true,
    "recordAudio": false,
    "windowEventDebounceTime": 200
  },
  "importedLibraries": [
    "mic-check",
    "nasa-tlx",
    "sus",
    "my-surveys"
  ],
  "components": {
    "Introduction": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/introduction.md",
      "response": [
        {
          "id": "manual-redcap-id",
          "prompt": "Before we begin, please enter your Research ID (S1xxx):",
          "type": "shortText",
          "required": true
        }
      ],
      "withSidebar": false
    },
    "ThinkAloudInstructions": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/thinkaloud-instructions.md",
      "response": [],
      "withSidebar": false
    },
    "Task0_Preparation": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task0-preparation.md",
      "description": "Preparation: Sign In and Start Recording",
      "response": [],
      "withSidebar": false
    },
    "Task1_ExploreApp": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task1-explore-app.md",
      "description": "Task 1: Explore the App",
      "response": [],
      "withSidebar": false
    },
    "Task2_Conversation1": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task2-conversation1.md",
      "description": "Task 2: Conversation 1",
      "instruction": "Please complete the task while thinking aloud. Describe what you are doing and what you are thinking as you interact with the chatbot.",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "conversation1-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Complete",
            "Partially complete",
            "Tried but did not complete",
            "Could not complete"
          ],
          "required": true
        },
        {
          "id": "conversation1-time",
          "prompt": "Approximately how long did this task take? Please answer in minutes.",
          "type": "numerical",
          "location": "sidebar",
          "min": 0,
          "max": 60,
          "required": true
        }
      ]
    },
    "Survey1": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/survey-link.md",
      "description": "Survey after Conversation 1",
      "withSidebar": false,
      "response": []
    },
    "RestBreak": {
      "previousButton": true,
      "type": "website",
      "path": "timer.html",
      "description": "Optional Rest Break",
      "instructionLocation": "aboveStimulus",
      "instruction": "You may take an optional break of up to 10 minutes before the next conversation.\n\n- **To take a break:** click **Start** to begin the timer. When you are ready, click **Next** below.\n- **To skip the break:** click **Next** below to continue right away.",
      "recordAudio": false,
      "response": []
    },
    "Task3_Conversation2": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task3-conversation2.md",
      "description": "Task 3: Conversation 2",
      "instruction": "Please complete the task while thinking aloud. Describe what you are doing and what you are thinking as you interact with the chatbot.",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "conversation2-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Complete",
            "Partially complete",
            "Tried but did not complete",
            "Could not complete"
          ],
          "required": true
        },
        {
          "id": "conversation2-time",
          "prompt": "Approximately how long did this task take? Please answer in minutes.",
          "type": "numerical",
          "location": "sidebar",
          "min": 0,
          "max": 60,
          "required": true
        }
      ]
    },
    "Survey2": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/survey-link.md",
      "description": "Survey after Conversation 2",
      "withSidebar": false,
      "response": []
    },
    "Task4_EndRecording": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task4-end-recording.md",
      "description": "Task 4: End Recording",
      "withSidebar": false,
      "response": []
    },
    "Test2_Overview": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/test2-overview.md",
      "description": "What Happens Next",
      "withSidebar": false,
      "response": []
    },
    "ThankYou": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/thankyou.md",
      "response": [],
      "withSidebar": false
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "Introduction",
      "ThinkAloudInstructions",
      "Task0_Preparation",
      "Task1_ExploreApp",
      "Task2_Conversation1",
      "Survey1",
      "RestBreak",
      "Task3_Conversation2",
      "Survey2",
      "Task4_EndRecording",
      "Test2_Overview",
      "ThankYou"
    ]
  }
}
