{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.1/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "AI Health Coach Follow-Up Evaluation",
    "version": "1.0.0",
    "authors": [
      "Lingyi Fu"
    ],
    "date": "2025-11-12",
    "description": "Follow-up think-aloud test of the AI health coach, about one week after the first session",
    "organizations": [
      "University of Utah"
    ]
  },
  "uiConfig": {
    "urlParticipantIdParam": "REDCAP_ID",
    "contactEmail": "Lingyi.Fu@utah.edu",
    "helpTextPath": "pa-chatbot_thinkaloud_follow_up/assets/help.md",
    "stylesheetPath": "pa-chatbot_thinkaloud_follow_up/assets/styles.css",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "logoTo": "/",
    "withProgressBar": false,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "enumerateQuestions": true,
    "recordAudio": false,
    "windowEventDebounceTime": 200
  },
  "importedLibraries": [
    "mic-check",
    "nasa-tlx",
    "sus",
    "my-surveys"
  ],
  "components": {
    "Introduction": {
      "previousButton": true,
      "type": "react-component",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/PersonalizedMarkdown.tsx",
      "parameters": {
        "path": "pa-chatbot_thinkaloud_follow_up/assets/introduction.md"
      },
      "response": [
        {
          "id": "manual-redcap-id",
          "prompt": "Before we begin, please enter your Research ID (S1xxx):",
          "type": "shortText",
          "required": true,
          "paramCapture": "REDCAP_ID"
        }
      ],
      "withSidebar": false
    },
    "ThinkAloudInstructions": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/thinkaloud-instructions.md",
      "response": [],
      "withSidebar": false
    },
    "Task0_Preparation": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task0-preparation.md",
      "description": "Preparation: Sign In and Start Recording",
      "instruction": "Complete the four steps on your phone: sign out, sign back in, wake up the coach, and start the session recording. Then answer the questions below.",
      "response": [
        {
          "id": "prep-signed-in",
          "prompt": "Did you sign out and sign back in to the app?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        },
        {
          "id": "prep-coach-awake",
          "prompt": "Did you wake up the coach (send \"hi\" on the Coach page)?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        },
        {
          "id": "prep-recording-started",
          "prompt": "Did you start the session recording on your phone?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        }
      ],
      "withSidebar": true
    },
    "Task1_ExploreApp": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task1-explore-app.md",
      "description": "Task 1: Explore the App",
      "instruction": "**Part 1:** View your Fitbit data on the Activity page.\n\n**Part 2:** In the SMART Goal section, tap a day, enter an activity under My daily report, and tap Save report.\n\nThink aloud as you go: what you notice, how easy it is to log your activity, and what you think of the page.",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "explore-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Complete",
            "Partially complete",
            "Could not complete"
          ],
          "required": true
        },
        {
          "id": "explore-reason",
          "prompt": "If you did not fully complete the task, what got in the way?",
          "type": "longText",
          "location": "sidebar",
          "required": false
        }
      ]
    },
    "Task2_Conversation1": {
      "previousButton": true,
      "type": "react-component",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/PersonalizedMarkdown.tsx",
      "parameters": {
        "path": "pa-chatbot_thinkaloud_follow_up/assets/task2-conversation1.md"
      },
      "description": "Task 2: Conversation 1",
      "instruction": "**While you chat, say out loud:**\n\n- What you think of the coach's replies\n- If stuck, what you're trying to do",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "conversation1-coach",
          "prompt": "Which health coach did you select?",
          "type": "dropdown",
          "placeholder": "Select a coach",
          "options": [
            "Luna",
            "Nova"
          ],
          "location": "sidebar",
          "required": true
        },
        {
          "id": "conversation1-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Complete",
            "Partially complete",
            "Could not complete"
          ],
          "required": true
        },
        {
          "id": "conversation1-reason",
          "prompt": "If you did not fully complete the task, what got in the way?",
          "type": "longText",
          "location": "sidebar",
          "required": false
        }
      ]
    },
    "Survey1": {
      "previousButton": true,
      "type": "react-component",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/PersonalizedMarkdown.tsx",
      "parameters": {
        "path": "pa-chatbot_thinkaloud_follow_up/assets/survey-link-conversation1.md"
      },
      "description": "Survey after Conversation 1",
      "withSidebar": false,
      "response": []
    },
    "RestBreak": {
      "previousButton": true,
      "type": "website",
      "path": "timer.html",
      "description": "Optional Rest Break",
      "instructionLocation": "aboveStimulus",
      "instruction": "You may take an optional break of up to 10 minutes before the next conversation.\n\n- **To take a break:** click **Start** to begin the timer. When you are ready, click **Next** below.\n- **To skip the break:** click **Next** below to continue right away.",
      "recordAudio": false,
      "response": []
    },
    "Task3_Conversation2": {
      "previousButton": true,
      "type": "react-component",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/PersonalizedMarkdown.tsx",
      "parameters": {
        "path": "pa-chatbot_thinkaloud_follow_up/assets/task3-conversation2.md"
      },
      "description": "Task 3: Conversation 2",
      "instruction": "**While you chat, say out loud:**\n\n- What you think of the coach's replies\n- If stuck, what you're trying to do",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "conversation2-coach",
          "prompt": "Which health coach did you select?",
          "type": "dropdown",
          "placeholder": "Select a coach",
          "options": [
            "Luna",
            "Nova"
          ],
          "location": "sidebar",
          "required": true
        },
        {
          "id": "conversation2-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Complete",
            "Partially complete",
            "Could not complete"
          ],
          "required": true
        },
        {
          "id": "conversation2-reason",
          "prompt": "If you did not fully complete the task, what got in the way?",
          "type": "longText",
          "location": "sidebar",
          "required": false
        }
      ]
    },
    "Survey2": {
      "previousButton": true,
      "type": "react-component",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/PersonalizedMarkdown.tsx",
      "parameters": {
        "path": "pa-chatbot_thinkaloud_follow_up/assets/survey-link-conversation2.md"
      },
      "description": "Survey after Conversation 2",
      "withSidebar": false,
      "response": []
    },
    "Task4_EndRecording": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/task4-end-recording.md",
      "description": "Task 4: End Recording",
      "withSidebar": false,
      "response": []
    },
    "Test2_Overview": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/test2-overview.md",
      "description": "What Happens Next",
      "withSidebar": false,
      "response": []
    },
    "ThankYou": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud_follow_up/assets/thankyou.md",
      "response": [],
      "withSidebar": false
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "Introduction",
      "ThinkAloudInstructions",
      "Task0_Preparation",
      "Task1_ExploreApp",
      "Task2_Conversation1",
      "Survey1",
      "RestBreak",
      "Task3_Conversation2",
      "Survey2",
      "Task4_EndRecording",
      "Test2_Overview",
      "ThankYou"
    ]
  }
}
