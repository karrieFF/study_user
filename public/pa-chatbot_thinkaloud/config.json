{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.1/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Think-Aloud Study: Chatbot App Evaluation Study",
    "version": "1.0.0",
    "authors": [
      "Lingyi Fu"
    ],
    "date": "2025-11-12",
    "description": "A think-aloud usability study to evaluate a chatbot app for promoting physical activity",
    "organizations": [
      "University of Utah"
    ]
  },
  "uiConfig": {
    "urlParticipantIdParam": "REDCAP_ID",
    "contactEmail": "Lingyi.Fu@utah.edu",
    "helpTextPath": "pa-chatbot_thinkaloud/assets/help.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "logoTo": "/",
    "withProgressBar": false,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "enumerateQuestions": true,
    "recordAudio": false,
    "windowEventDebounceTime": 200
  },
  "importedLibraries": [
    "mic-check",
    "nasa-tlx",
    "sus",
    "my-surveys"
  ],
  "components": {
    "Introduction": {
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/introduction.md",
      "response": [
        {
          "id": "manual-redcap-id",
          "prompt": "Before we begin, please enter your Research ID (S1xxx):",
          "type": "shortText",
          "required": true
        }
      ],
      "withSidebar": false
    },
    "ThinkAloudInstructions": {
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/thinkaloud-instructions.md",
      "response": [],
      "withSidebar": false
    },
    "Warm-up": {
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/Warm-up.md",
      "response": [],
      "withSidebar": false
    },
    "Task0_scenario": {
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/task0-chatbotapp.md",
      "response": [],
      "withSidebar": false
    },
    "Task1_chatbotapp": {
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/task1-chatbotapp.md",
      "description": "Task 1",
      "instruction": "Please complete the task while thinking aloud. Describe what you're doing and what you're thinking as you interact with the chatbot.",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "task1-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        },
        {
          "id": "task1-difficulty",
          "prompt": "How difficult was this task?",
          "type": "likert",
          "location": "sidebar",
          "numItems": 7,
          "leftLabel": "Very easy",
          "rightLabel": "Very difficult",
          "required": true
        },
        {
          "id": "task1-time",
          "prompt": "Approximately how long did this task take? (in minutes)",
          "type": "numerical",
          "location": "sidebar",
          "min": 0,
          "max": 60,
          "required": true
        }
      ]
    },
    "Survey1": {
      "type": "website",
      "path": "https://redcap01.brisc.utah.edu/ccts/redcap/surveys/",
      "recordAudio": false,
      "withSidebar": true,
      "instruction": "1. The access code can be found in the email we sent you before the study.\n2. Please scroll down to click the \"Next Page\" of the survey. You will see \"Thank you for taking the survey\" once you finish.\n3. Please make sure to complete the survey before clicking the \"Next\" button below.",
      "response": [{
          "id": "task2-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        }]
    },
    "RestBreak": {
      "type": "website",
      "path": "timer.html",
      "description": "20 Minute Rest Break",
      "instruction": "Please take a 20-minute break before starting the next task.\n\nClick the \"Start\" button to begin the timer.\n\nWhen the timer ends, click the \"Next\" button below to proceed to the next task.",
      "recordAudio": false,
      "response": []
    },
    "Task2_chatbotapp": {
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/task2-chatbotapp.md",
      "description": "Task 2",
      "instruction": "Please complete the task while thinking aloud. Describe what you're doing and what you're thinking as you interact with the chatbot.",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "task2-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        },
        {
          "id": "task2-difficulty",
          "prompt": "How difficult was this task?",
          "type": "likert",
          "location": "sidebar",
          "numItems": 7,
          "leftLabel": "Very easy",
          "rightLabel": "Very difficult",
          "required": true
        },
        {
          "id": "task2-time",
          "prompt": "Approximately how long did this task take? (in minutes)",
          "type": "numerical",
          "location": "sidebar",
          "min": 0,
          "max": 60,
          "required": true
        }
      ]
    },
    "Survey2": {
      "type": "website",
      "path": "https://redcap01.brisc.utah.edu/ccts/redcap/surveys/",
      "recordAudio": false,
      "withSidebar": true,
      "instruction": "1. The access code can be found in the email we sent you before the study.\n2. Please scroll down to click the \"Next Page\" of the survey. You will see \"Thank you for taking the survey\" once you finish. \n3. Please make sure to complete the survey before clicking the \"Next\" button below.",
      "response": [{
          "id": "task2-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        }]
    },
    "ThankYou": {
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/thankyou.md",
      "response": [],
      "withSidebar": false
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "Introduction",
      "ThinkAloudInstructions",
      "Warm-up",
      "Task0_scenario",
      "Task1_chatbotapp",
      "Survey1",
      "RestBreak",
      "Task2_chatbotapp",
      "Survey2",
      "$nasa-tlx.co.nasa-tlx",
      "ThankYou"
    ]
  }
}