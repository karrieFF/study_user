{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.1/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Think-Aloud Study: Chatbot App Evaluation Study",
    "version": "1.0.0",
    "authors": [
      "Lingyi Fu"
    ],
    "date": "2025-11-12",
    "description": "A think-aloud usability study evaluating a chatbot app for promoting physical activity",
    "organizations": [
      "University of Utah"
    ]
  },
  "uiConfig": {
    "urlParticipantIdParam": "REDCAP_ID",
    "contactEmail": "Lingyi.Fu@utah.edu",
    "helpTextPath": "pa-chatbot_thinkaloud/assets/help.md",
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "logoTo": "/",
    "withProgressBar": false,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "enumerateQuestions": true,
    "recordAudio": false,
    "windowEventDebounceTime": 200
  },
  "importedLibraries": [
    "mic-check",
    "nasa-tlx",
    "sus",
    "my-surveys"
  ],
  "components": {
    "Introduction": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/introduction.md",
      "response": [
        {
          "id": "manual-redcap-id",
          "prompt": "Before we begin, please enter your Research ID (S1xxx):",
          "type": "shortText",
          "required": true
        }
      ],
      "withSidebar": false
    },
    "ThinkAloudInstructions": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/thinkaloud-instructions.md",
      "response": [],
      "withSidebar": false
    },
    "Warm-up": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/Warm-up.md",
      "response": [],
      "withSidebar": false
    },
    "Task0_scenario": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/task0-chatbotapp.md",
      "response": [],
      "withSidebar": false
    },
    "Task1_chatbotapp": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/task1-chatbotapp.md",
      "description": "Task 1",
      "instruction": "Please complete the task while thinking aloud. Describe what you are doing and what you are thinking as you interact with the chatbot.",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "task1-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        },
        {
          "id": "task1-time",
          "prompt": "Approximately how long did this task take? Please answer in minutes.",
          "type": "numerical",
          "location": "sidebar",
          "min": 0,
          "max": 60,
          "required": true
        }
      ]
    },
    "Survey1": {
      "previousButton": true,
      "type": "website",
      "path": "https://redcap01.brisc.utah.edu/ccts/redcap/surveys/",
      "recordAudio": false,
      "withSidebar": true,
      "instruction": "1. The access code can be found in the email we sent you before the study.\n2. Please scroll down and click \"Next Page\" in the survey. You will see \"Thank you for taking the survey\" once you finish.\n3. Please complete the survey before clicking the \"Next\" button below.",
      "response": [{
          "id": "survey1-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        }]
    },
    "RestBreak": {
      "previousButton": true,
      "type": "website",
      "path": "timer.html",
      "description": "20-Minute Rest Break",
      "instruction": "Please take a 20-minute break before starting the next task.\n\nClick the \"Start\" button to begin the timer.\n\nWhen the timer ends, click the \"Next\" button below to proceed to the next task.",
      "recordAudio": false,
      "response": []
    },
    "Task2_chatbotapp": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/task2-chatbotapp.md",
      "description": "Task 2",
      "instruction": "Please complete the task while thinking aloud. Describe what you are doing and what you are thinking as you interact with the chatbot.",
      "recordAudio": false,
      "withSidebar": true,
      "response": [
        {
          "id": "task2-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        },
        {
          "id": "task2-time",
          "prompt": "Approximately how long did this task take? Please answer in minutes.",
          "type": "numerical",
          "location": "sidebar",
          "min": 0,
          "max": 60,
          "required": true
        }
      ]
    },
    "Task3_chatbotapp": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/task3-chatbotapp.md",
      "description": "Task 3",
      "withSidebar": true,
      "response": [
        {
          "id": "task3-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        }
      ]
    },
    "Survey2": {
      "previousButton": true,
      "type": "website",
      "path": "https://redcap01.brisc.utah.edu/ccts/redcap/surveys/",
      "recordAudio": false,
      "withSidebar": true,
      "instruction": "1. The access code can be found in the email we sent you before the study.\n2. Please scroll down and click \"Next Page\" in the survey. You will see \"Thank you for taking the survey\" once you finish.\n3. Please complete the survey before clicking the \"Next\" button below.",
      "response": [{
          "id": "survey2-completed",
          "prompt": "Did you successfully complete the task?",
          "type": "radio",
          "location": "sidebar",
          "options": [
            "Yes, completely",
            "Yes, partially",
            "No, but I tried",
            "No, I couldn't figure it out"
          ],
          "required": true
        }]
    },
    "ThankYou": {
      "previousButton": true,
      "type": "markdown",
      "path": "pa-chatbot_thinkaloud/assets/thankyou.md",
      "response": [],
      "withSidebar": false
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "Introduction",
      "ThinkAloudInstructions",
      "Task0_scenario",
      "Warm-up",
      "Task1_chatbotapp",
      "Survey1",
      "RestBreak",
      "Task2_chatbotapp",
      "Task3_chatbotapp",
      "Survey2",
      "$nasa-tlx.co.nasa-tlx",
      "ThankYou"
    ]
  }
}
